# Public targets of lri_3d_c4_exact (d = 3 exact finite-cutoff sums: C2..C4(L) to L = 600, C5(L) to L = 40, window
# shifts to L = 8000; the paper's C2..C4(3) and the provisional C5(3)). Run from this folder: make -f public.mk <target>
# (HT_Pert/Makefile runs make -C code/lri_3d_c4_exact -f public.mk <target>). The package's files ship unchanged at
# git ref d5afa4f; everything public-specific is in public/. The sibling ../lri_3d_hpc (production package) and
# ../../data/HT_3d/pert3d/results (its campaign records) are read by the validation steps.
#
#   target      what                                                          measured runtime and node
#   replay      reruns the package's analysis scripts on the shipped results  about 2 s, 1 core, any OS (numpy)
#               (fits/*.txt regenerated byte for byte), recomputes every
#               quoted number with its rule, validates against lri_3d_hpc
#               (public/replay_exact3d.py); PASS/FAIL, exit 1 on FAIL
#   test        recomputes the sums from scratch at small L (windows to 400,  see public/REPRODUCE.md (symmetry runs)
#               C4 to 40, C5 in every scheme to 12, shifts, brute force on
#               the package operators) and compares (public/run_tests.py)
#   clean       remove .work/
PY      ?= python3
WORK    ?= .work

.PHONY: help replay test clean

help:        ## list the targets
	@grep -E '^[a-z-]+:.*##' public.mk | sed 's/:.*##/:/'

replay:      ## the paper's d = 3 HT numbers from the shipped exact sums; PASS/FAIL table in .work/replay/
	$(PY) -B public/replay_exact3d.py --out $(WORK)/replay

test:        ## recompute the exact sums at small cutoffs and compare with the shipped results, the package, the brute force
	C4X_PUBLIC_WORK=$(WORK)/test $(PY) -B public/run_tests.py

clean:       ## remove .work/
	rm -rf $(WORK)
