+    def fd_jacobian(self,theta,step_scale=1e-4):
+        """Central finite differences of the full tuning residual (4 complete spectra, window included).
+
+        Opt-in alternative to response_jacobian; it changes only the Newton direction, never the
+        residual, the gates or the accepted root."""
+        t=time.perf_counter();jac=np.empty((2,2))
+        for j in range(2):
+            h=step_scale*max(1,abs(theta[j]));vals=[]
+            for sign in (1,-1):
+                th=np.array(theta,dtype=float);th[j]+=sign*h
+                vals.append(self.spectrum(th,k=3)[0])
+            jac[:,j]=(vals[0]-vals[1])/(2*h)
+        self.timings['jacobian']+=time.perf_counter()-t
+        return jac
+
