+def test_fd_jacobian_matches_response_and_reaches_same_root():
+    s=DressedSolver(4,16,128,window='vacuum',eig_tol=1e-13);s.set_delta(.3)
+    r=s.solve(tol=1e-11);u,t,meta=select_density_basis(s,r['theta'],10)
+    d=DensitySolver(4,u,t,window='vacuum',eig_tol=1e-13);d.set_delta(.3)
+    th=np.array(r['theta'])+np.array([.05,-.02])
+    _,info,out,U=d.spectrum(th,k=3)
+    err=np.max(abs(d.fd_jacobian(th)-d.response_jacobian(th,out,U)))
+    METRICS['fd_vs_response_jacobian_off_root']=float(err);assert err<1e-6
+    rows={}
+    for jac in ('response','fd'):
+        d=DensitySolver(4,u,t,window='vacuum',eig_tol=1e-13);d.set_delta(.3)
+        rows[jac]=d.solve(th.tolist(),tol=1e-11,jacobian=jac)
+    assert 'finite-difference' in rows['fd']['solver'] and 'finite-difference' not in rows['response']['solver']
+    np.testing.assert_allclose(rows['fd']['theta'],rows['response']['theta'],rtol=0,atol=1e-9)
+    for key in ('even_gaps','odd_gaps'):
+        np.testing.assert_allclose(rows['fd'][key],rows['response'][key],rtol=0,atol=1e-10)
+    # Positional binding: execution and metadata use the same effective Jacobian (FDJAC-01).
+    d=DensitySolver(4,u,t,window='vacuum',eig_tol=1e-13);d.set_delta(.3)
+    pos=d.solve(th.tolist(),1e-11,30,True,'fd')
+    assert 'finite-difference' in pos['solver']
+    np.testing.assert_allclose(pos['theta'],rows['response']['theta'],rtol=0,atol=1e-9)
+    with pytest.raises(ValueError):d.solve(th.tolist(),jacobian='broyden')
+
