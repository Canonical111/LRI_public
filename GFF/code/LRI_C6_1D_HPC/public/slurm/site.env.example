# Site values for a production rerun of C6(1) (read by public/slurm/adapt.py; KEY=VALUE, no spaces around '=').
# Copy to site.env and fill in. Everything else in cluster/ stays as it ran on symmetry.

# Campaign directory on a shared file system visible to all nodes (code/, data/, levels/, runs/, logs/,
# validation/, decisions/, analysis/ are created below it). About 1 GB is enough (graphs and weights 0.25 GB).
C6_HOME=<SCRATCH>/lri_c6_1d
# Slurm account, exported as SBATCH_ACCOUNT by cluster/env.sh (leave empty if the site needs none).
ACCOUNT=<ACCOUNT>
# Environment modules giving g++ >= 11 with OpenMP and Python 3.8+ with numpy and mpmath (symmetry used
# "gcc/11.2.0 anaconda3/2023.07-2"). Leave empty to use what is on PATH.
MODULES=<MODULES>
# Whole-node partition for the engine arrays, batches and validation gates (x86-64 with AVX2/FMA; symmetry: amdq,
# 64-core AMD EPYC 7532/7543, then defq, 40-core Intel Xeon Gold 6148).
PART_MAIN=<PARTITION>
# Optional second partition tried after PART_MAIN when PART_MAIN has fewer idle nodes than a stage needs.
PART_FALLBACK=
# Partition for the prepare job (build, graph enumeration, weights; under 1 h on one node).
PART_DEBUG=<DEBUG_PARTITION>
# Partition for the 1-2 core merge and collector jobs (30 min, 4 GB).
PART_SHARED=<SHARED_PARTITION>
# Partition whose CPUs come from the other vendor than PART_MAIN (gate V11, AMD versus Intel). Leave empty on a
# single-vendor cluster: adapt.py then drops the cross-architecture job and its four V11 gates.
PART_XARCH=
# Memory request of the whole-node jobs (symmetry: 180G). The engines need a few GB.
MEM=180G
# The recon record of gate V3_all_N6_vs_recon_compensated (not shipped). Leave empty to drop that one gate;
# V3_all_N6_vs_reference against the shipped reference record stays.
RECON_FILE=
