# C8_ENV for LRI_C8_D2_HPC on symmetry (created 2026-10-03, PLAN.md "Common setup"): the C7(2) lines with the paths
# renamed (system GCC 11.4 + Boost 1.77 module headers + system GMP 6.2.1 + python/3.11 venv ~/c8d2/venv with
# numpy 2.3.5, scipy 1.17.1, mpmath 1.3.0, sympy 1.14.0), Slurm on PATH, plus the H7 AMD-pool cap: at most 4 live
# c8d2- jobs on amdq, amddebugq and amdpreq together (PLAN D3, agreed with C63d 2026-10-03).
# Safe to source under `set -euo pipefail`: the module system and the venv activation run with nounset suspended.
case $- in *u*) _c8_nounset=1; set +u ;; *) _c8_nounset=0 ;; esac
source /etc/profile.d/modules.sh
module load boost/1.77.0 python/3.11
export PATH=/cm/shared/apps/slurm/current/bin:$PATH
source "$HOME/c8d2/venv/bin/activate"
export C8_PYTHON="$(command -v python3)"
export C8_AMDQ_CAP=4
if [ "$_c8_nounset" = 1 ]; then set -u; fi
unset _c8_nounset
