# Example C8_ENV_SETUP files. Copy ONE block into your own file, adapt the venv path, and
#   export C8_ENV_SETUP=/path/to/your/env.sh
# It is sourced by slurm/*.sh with errexit on and before nounset, and must give: the compiler, Boost 1.77 headers and
# GMP 6.2.1 used to build bin/ (keep them fixed for a whole campaign), a Python >= 3.10 holding requirements.txt (venv),
# and sbatch/squeue/scontrol/sacct on PATH. Build once with the same environment: source <file>; make && make gmp && make test
# Check the Boost a build saw: BOOST_LIB_VERSION in bin/*.build.json must read "1_77".

# ---- symmetry (Perimeter): system GCC 11.4 + Boost 1.77 module headers + system GMP 6.2.1 + python/3.11 venv.
#      Install as ~/c8d2/env.sh. The H7 AMD-pool cap (C63d, 2026-10-03): during development at most 4 AMD nodes per
#      session at a time, amdq, amddebugq and amdpreq counted together; slurm_submit.py enforces it from C8_AMDQ_CAP.
#      The file supplies 4 only as a DEFAULT: an explicit agreed window (C8_AMDQ_CAP=<n> slurm/submit.sh ...) is kept,
#      higher or lower (X11).
source /etc/profile.d/modules.sh
module load boost/1.77.0 python/3.11
export PATH=/cm/shared/apps/slurm/current/bin:$PATH
source "$HOME/c8d2/venv/bin/activate"
export C8_PYTHON="$(command -v python3)"
export C8_SITE=symmetry
export C8_AMDQ_CAP="${C8_AMDQ_CAP:-4}"
export C8_SEEDS=/mnt/beegfs/zzheng1/c8-d2/forbidden_seeds.json
# symmetry: CPU partitions give whole EXCLUSIVE nodes and have finite limits (amdq/defq 24 h, amddebugq/debugq 1 h);
# keep C8_TIME_POLICY=finite (default); lanes: C8_SBATCH_ARGS="-p amdq --exclude=cn112" C8_LANE_MEM=245G (amdq only;
# 180G also fits the Intel nodes); campaign directories on /mnt/beegfs/$USER; MaxArraySize 1001.
# One CPU vendor per campaign (F5, docs/HPC.md): native rows differ between the AMD (amdq, amddebugq) and Intel (defq,
# debugq) nodes at about 1e-16, and production.py run refuses (exit 64) a claim on another vendor than the campaign's
# first claim. Never list partitions of both vendors in one C8_SBATCH_ARGS.
# sharedq (lane drills): at most 8 CPUs and 2,000 MB per CPU, PreemptMode=REQUEUE, 4 running jobs per user.

# ---- SDSC Expanse (account yun124): slurm/env_expanse.sh is the installed file (~/c8d2/env_expanse.sh): Spack GCC 13.3.0,
#      Boost 1.77 headers BY PATH (the boost/* modules set only BOOST_ROOT, not CPATH, so a plain build would see the system
#      Boost 1.66), Spack GMP 6.2.1, python/3.11.9 venv, C8_SITE=expanse, C8_DATA on Lustre. Admission (H7E-R,
#      LRI_C8_shared/inventory/DECISIONS.md): at most 11 running / 27 submitted normal-QOS c8d2-* jobs, the whole account
#      at most 32 running, at most 32 live shared-partition jobs and 4 compute nodes during development; slurm_submit.py
#      checks all of it (squeue -A yun124) under the site lock ~/.c8_site_expanse.lock.
#      lanes:  C8_SBATCH_ARGS="-A yun124 -p compute" C8_LANE_MEM=240G slurm/submit.sh --lanes 1
#      arrays: plan with --threads 32; C8_SBATCH_ARGS="-A yun124 -p shared" slurm/submit.sh (--mem from the plan's suggestion)

# ---- personal desktops (Slurm workstations): the site rule is no wall-time cap, so export C8_TIME_POLICY=unlimited
#      (every job gets --time=0 and TimeLimit=UNLIMITED is verified after each sbatch; lanes then have no deadline).
