M (I = sum_jk M_jk I_j I_k), rows/cols I1..I6:
   [0, 2*I, 0, -2*I*q, -2*I, 2]
   [2*I, 0, -2*I*q, -2*q, 2, 0]
   [0, -2*I*q, 0, 2*I, 2*I*q, -2*q]
   [-2*I*q, -2*q, 2*I, 0, 0, 2*I*q]
   [-2*I, 2, 2*I*q, 0, 0, 2*I]
   [2, 0, -2*q, 2*I*q, 2*I, 0]
I = 4*I*I1*I2 - 4*I*I1*I4*q - 4*I*I1*I5 + 4*I1*I6 - 4*I*I2*I3*q - 4*I2*I4*q + 4*I2*I5 + 4*I*I3*I4 + 4*I*I3*I5*q - 4*I3*I6*q + 4*I*I4*I6*q + 4*I*I5*I6
after moment relations and c^2 = 1 - s^2:  I = 4*s**2*(I3**2 + I4**2)
