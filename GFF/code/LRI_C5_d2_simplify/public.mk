# Public targets of LRI_C5_d2_simplify: discovery and 70-digit numerical confirmation of the d = 2 closed forms
# L2 = -2 log2 P4(2) and K2 = 32 G^2 - 28 zeta(3) log2, three further proofs (proof/), and the closed form of C5(2)
# (note Sections 17.2, 18.6-18.7). Plain folder, shipped as it was on 2026-10-02.
# Run from this folder: make -f public.mk <target>.
# Paths are relative. Shipped files are never modified. Every shipped script runs in a work copy under public/out/work/,
# where public/cf2common.py maps the hard-coded research-tree prefix to GFF/code.
#
#   test     factorizations regenerated byte for byte, all 50 single sums and identities at 18 digits from scratch, the
#            exact sympy checks of the proof fragment, closed forms at 30 digits
#            (about 30 s; Python >= 3.10 with mpmath >= 1.2.1 and sympy 1.11.1; any OS)
#   replay   the production's own assembly re-run on the 50 stored 70-digit single sums, the recorded residuals, every quoted
#            decimal of L2, K2 and C5(2) from the closed forms at 80 digits, and the independent spectral record in
#            ../LRI_C5_d3/wf_d2check (about 5 s; same requirements)
#   checks   optional: the prover scripts of the three further proofs (proof/*/), each in a work copy, compared with
#            their shipped logs where they exist (minutes; e2check.py takes about 6 min on 8 cores)
#   rerun70  optional, a production rerun: all 50 single sums at 70 digits (1852 s on one 64-core node; see
#            REPRODUCE.md for a Slurm template). Compares the new record with confirm_dps70.json.

PY  ?= python3
OUT ?= public/out
NP  ?= 8

.PHONY: help test replay checks rerun70 clean

help:            ## list the targets
	@grep -E '^[a-z0-9-]+:.*##' public.mk | sed 's/:.*##/:/'

test:            ## fast tests (about 30 s)
	$(PY) -B public/test.py --out $(OUT)

replay:          ## recompute every quoted number of the closed forms and compare (PASS/FAIL table, public/out/replay.json)
	$(PY) -B public/replay.py --out $(OUT)

checks:          ## optional: prover scripts of proof/L2-fourier, proof/L2-elliptic, proof/K2-parseval in work copies
	CONFIRM_JSON=$(CURDIR)/confirm_dps70.json $(PY) -B public/cf2common.py run proof/L2-fourier/check_reduction.py 60
	$(PY) -B public/cf2common.py run proof/L2-fourier/check_strip.py 60
	$(PY) -B public/cf2common.py run proof/L2-fourier/collapse.py
	for s in check_basic check_collapse check_parseval check_rimderivative collapse_sympy; do \
	  $(PY) -B public/cf2common.py run proof/L2-elliptic/$$s.py || exit 1; done
	for s in symbolic_checks check_taylor_inputs check_periodization check_perspin; do \
	  $(PY) -B public/cf2common.py run proof/K2-parseval/$$s.py || exit 1; done
	$(PY) -B public/cf2common.py run proof/K2-parseval/e2check.py $(NP)

rerun70:         ## optional production rerun: 50 single sums at 70 digits in public/out/work/parallel_eval (cluster node)
	$(PY) -B public/cf2common.py run parallel_eval.py 70
	$(PY) -B -c "import json,mpmath as mp; mp.mp.dps=90; a=json.load(open('$(OUT)/work/parallel_eval/confirm_dps70.json')); b=json.load(open('confirm_dps70.json')); w=max(abs(mp.mpf(a['singles'][k])/mp.mpf(v)-1) for k,v in b['singles'].items()); print('max relative difference of the 50 singles:', mp.nstr(w,3)); raise SystemExit(0 if w<mp.mpf('1e-65') else 1)"

clean:
	rm -rf $(OUT)
