# C8_ENV_SETUP for LRI_C8_D3_HPC on symmetry (Amendment A1 to PLAN.md, 2026-10-05; D.10). Copy to ~/c8d3/env.sh and
# export C8_ENV_SETUP=$HOME/c8d3/env.sh (this file does it). Sourced by every job script with errexit on and BEFORE
# nounset: no `set -u` in here. C8_SCRATCH is deliberately NOT set here: each job computes it at start ($SLURM_TMPDIR,
# else /local1/$USER/job_$SLURM_JOB_ID on symmetry, slurm/site.sh), so a login-node value cannot leak into a job.
# Toolchain: system GCC 11.4, the boost/1.77.0 module's headers and system GMP 6.2.1 (C7(3) run1's toolchain; bitwise
# gates hold within one toolchain only, HD9). Build on an AMD AVX2 node (amdq or amddebugq; cn112 is excluded).
# No C8_GMP, LDFLAGS or RPATH here: the loader finds the system libgmp.so.10 in /usr/lib/x86_64-linux-gnu, which
# tests/check_build.py expects on symmetry (--gmp-search system, slurm/site.sh). The c8-stage3 baseline of this site is
# reference/baseline_c8_stage3_symmetry.json (tools/baseline.py; recorded 2026-10-05 from J-BASE-sym 570275), never Expanse's.
source /etc/profile.d/modules.sh
module load boost/1.77.0 python/3.11
export PATH=/cm/shared/apps/slurm/current/bin:$PATH
# The venv: python3.11 -m venv ~/c8d3/venv; pip install -r requirements.txt (numpy 2.3.5, scipy 1.17.1, mpmath 1.3.0,
# sympy 1.14.0, pytest).
source "$HOME/c8d3/venv/bin/activate"
export C8_PYTHON="$(command -v python3)"
export C8_SITE=symmetry
export C8_ROOT=<SCRATCH>/c8d3
export C8_STORE=$C8_ROOT/store
# The forbidden-seed log (HD6). It never starts empty here: create it once as a copy of Expanse's $C8_SEEDS or of the
# package mirror (tools/seeds.py init --from <copy>; refused without --from on symmetry, and a copy that lacks a seed of
# designs/forbidden_seeds.json is refused), and fold in Expanse's newer entries with tools/seeds.py merge (docs/HPC.md,
# "Symmetry", the seed log). seeds.py add refuses a missing log; a non-test plan on symmetry refuses a forbidden set that
# lacks a seed of the package mirror.
export C8_SEEDS=$C8_ROOT/forbidden_seeds.json
# H7 (LRI_C8_shared/inventory/DECISIONS.md, A5): at most 4 AMD-pool nodes per session in development, amdq, amddebugq
# and amdpreq counted together, both sessions 8; Intel defq/debugq outside the cap. The pilot window (DECISIONS
# 2026-10-05, "H11 pilot window on symmetry") re-splits it through its own DECISIONS line with an expiry:
#   pilot session:  C8_RESERVATION="mode=reservation;id=<DECISIONS item>;amd_nodes=5;amd_total=8;until=<UTC>"
#   other session:  C8_RESERVATION="mode=reservation;id=<DECISIONS item>;amd_nodes=3;amd_total=8;until=<UTC>"
export C8_RESERVATION="mode=reservation;id=H7;amd_nodes=4;amd_total=8"
export C8_LOCK_WAIT=1800
export C8_BUDGET_LINE=${C8_BUDGET_LINE:-dev}
# Production (user decision 2026-10-08; docs/PRODUCTION_RUNBOOK.md): C8_BUDGET_LINE=production with
# C8_PRODUCTION_SU_CAP=<the approved core-h>, set in the login shell for the production steps only (roles prod_<role>).
# A1.3: symmetry core-hours (whole nodes: 64 per AMD node, 80 per Intel node) and Expanse SU count 1:1 in one dev line
# (stop and ask at 4,000, cap 5,000) and one pilot line. In the login shell before each admission (not here: it is a
# measurement, not a setting), set Expanse's own line totals: the `carry` line that Expanse's `tools/budget.py` prints
# (spent + live reservations + unresolved intents, without Expanse's own carry), "dev=0;pilot=0;asof=<now>;ref=<why>"
# while Expanse has no c8d3- job since the epoch. Admission and budget.py refuse (64) while it is unset, older than
# 24 h or in the future; refresh it after every submission on Expanse:
#   export C8_OTHER_SITE_SU="dev=<x>;pilot=<y>;asof=<UTC YYYY-MM-DDTHH:MM:SSZ>;ref=<where the numbers come from>"
# (a carry from an export with the production line also has production=<z>; without it, production is 0)
# Only an A1 export (66f3c8d or later) reads the carry: admit through $C8_PACKAGE/tools/slurm_submit.py of such an
# export; an older export gates on this site alone (docs/HPC.md, A1.3 "Only an A1 export enforces the joint line").
export C8_MERGE_SCRATCH_BYTES=500000000000   # node-local /local1 (about 568 GB per node) [I]
# The CPU pin (HD11): every AMD-pool job excludes cn112 and budget.SYMMETRY.cpu_exclude (the AMD nodes known not to be
# EPYC 7543: <NODE>-082, <NODE>, <NODE>, and since Stage 6 <NODE> and <NODE>, which the guard found in Stage 5, so this list
# no longer needs them). C8_AMD_EXCLUDE_EXTRA adds nodes without a code change: list only AMD nodes whose cpuinfo model
# name is not 'AMD EPYC 7543 32-Core Processor', found by a 68 refusal (slurm/site.sh c8_cpu_guard) or a probe; move them
# into budget.SYMMETRY.cpu_exclude at the next code commit; never use it to remove cn112 or a constant node (it can only add).
# export C8_AMD_EXCLUDE_EXTRA=cnNNN[,cnNNN]
export C8_ENV_SETUP=$HOME/c8d3/env.sh
# Fixed in the package, never set here: the lock path, the ledger and intent paths, the budget epoch (D.12, HD17).
# The session lock is <HOME>/c8d3/locks/c8d3.lock on the NFS home (Amendment A1 addendum L), not under C8_ROOT:
# BeeGFS runs with tuneUseGlobalFileLocks = 0 here (flock() on the local node only). tools/ledger.py refuses (69) unless
# its mount is NFS with local_lock=none (and not nolock).
