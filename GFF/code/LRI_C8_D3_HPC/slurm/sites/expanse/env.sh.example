# C8_ENV_SETUP for LRI_C8_D3_HPC on Expanse (plan D.10). Copy to ~/c8d3/env.sh, adapt nothing but marked lines, and
# export C8_ENV_SETUP=$HOME/c8d3/env.sh (this file does it). Sourced by every job script with errexit on and BEFORE
# nounset: no `set -u` in here (it breaks /etc/bashrc). C8_SCRATCH is deliberately NOT set here: each job computes it
# at start ($SLURM_TMPDIR, else /scratch/$USER/job_$SLURM_JOB_ID, never /tmp), so a login-node value cannot leak into a
# job through --export=ALL.
module purge
module load cpu/0.21.2a gcc/13.3.0
module load slurm/expanse/23.02.7
# Boost 1.77 headers and GMP 6.2.1 by explicit Spack paths (F29; the boost module sets only BOOST_ROOT, and loading
# boost/1.86.0 would put py-numpy on PYTHONPATH). RPATH to the Spack GMP for every build (HD9).
export C8_BOOST=/cm/shared/apps/spack/0.17.3/cpu/b/opt/spack/linux-rocky8-zen2/gcc-10.2.0/boost-1.77.0-bbnd4wnz3ueozpqlp2sz6rhsi2o2tuzn
export C8_GMP=/cm/shared/apps/spack/0.21.2/cpu/a/opt/spack/linux-rocky8-zen2/gcc-13.3.0/gmp-6.2.1-eywq454gcb355knxklm3gnfrkmj3nscw
export CPATH=$C8_BOOST/include:$C8_GMP/include${CPATH:+:$CPATH}
export LIBRARY_PATH=$C8_GMP/lib${LIBRARY_PATH:+:$LIBRARY_PATH}
export LD_LIBRARY_PATH=$C8_GMP/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export LDFLAGS=-Wl,-rpath,$C8_GMP/lib
# The venv: Python 3.11.9 with requirements.txt (numpy 2.3.5, scipy 1.17.1, mpmath 1.3.0, sympy 1.14.0, pytest).
source "$HOME/c8d3/venv/bin/activate"
export C8_PYTHON="$(command -v python3)"
export C8_SITE=expanse
export C8_ROOT=<SCRATCH>/temp_project/c8d3
export C8_STORE=$C8_ROOT/store
export C8_SEEDS=$C8_ROOT/forbidden_seeds.json
export C8_COMPUTE_CAP=4
# The agreed disjoint reservation H7E-R, LRI_C8_shared/inventory/DECISIONS.md:87 (sha256 of that file when copied,
# 2026-10-04: c81aa0faae0da6f420a6f54c3116ab48131ea2206e8b7734228d309a0faf67a8), quoted:
#   "AGREED by C62d and C63d ... C62d at most 11 running / 27 submitted c8d2-* jobs; C63d at most 11 / 27 c8d3-* jobs.
#    Every admission also checks that the whole <ACCOUNT> account stays at or below 32 running, other users included.
#    Shared partition: at most 32 live jobs per session. Development: at most 4 compute nodes per session. A pilot
#    window can re-split the budget temporarily, through a DECISIONS line. Each submitter needs only its own lock."
export C8_RESERVATION="mode=reservation;id=H7E-R;run=11;sub=27;acct_run=32;shared=32;dev_nodes=4"
export C8_LOCK_WAIT=1800
export C8_BUDGET_LINE=${C8_BUDGET_LINE:-dev}
# Amendment A1.3: Expanse SU and symmetry core-hours count 1:1 in one dev line (stop and ask at 4,000, cap 5,000) and
# one pilot line. In the login shell before each admission (not here: it is a measurement, not a setting), set
# symmetry's own line totals: the `carry` line that symmetry's `tools/budget.py` prints (spent + live reservations +
# unresolved intents, without symmetry's own carry), or "dev=0;pilot=0;asof=<now>;ref=<why>" while symmetry has no
# c8d3- job since the epoch. Admission and budget.py refuse (64) while it is unset, older than 24 h or in the future;
# refresh it after every submission on symmetry:
#   export C8_OTHER_SITE_SU="dev=<x>;pilot=<y>;asof=<UTC YYYY-MM-DDTHH:MM:SSZ>;ref=<where the numbers come from>"
# Only an A1 export (66f3c8d or later) reads the carry: admit through $C8_PACKAGE/tools/slurm_submit.py of such an
# export; an older export gates on this site alone (docs/HPC.md, A1.3 "Only an A1 export enforces the joint line").
export C8_FILE_BUDGET=300000 C8_PARTNER_FILE_RESERVE=300000
export C8_ENV_SETUP=$HOME/c8d3/env.sh
# Fixed in the package, never set here: the lock path, the ledger and intent paths, the budget epoch (D.12, HD17).
