# Copy this file and adapt it to your cluster's module names and paths.
# The C8 code has been tested locally; no C8 cluster run is asserted here.

# module load gcc boost gmp python
# source /shared/path/to/c8-venv/bin/activate
export C8_PYTHON="$(command -v python3)"
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

# If a Boost module sets BOOST_ROOT but not the compiler include path:
# export CPATH="$BOOST_ROOT/include${CPATH:+:$CPATH}"
# For a GMP module that needs explicit paths:
# export CPATH="/path/to/gmp/include${CPATH:+:$CPATH}"
# export LIBRARY_PATH="/path/to/gmp/lib${LIBRARY_PATH:+:$LIBRARY_PATH}"
# export LD_LIBRARY_PATH="/path/to/gmp/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Campaign directory and package must be visible to all compute nodes.
# Set C8_SBATCH_ARGS in the submitting shell, for example:
# export C8_SBATCH_ARGS="-A your_project -p your_partition --time=08:00:00"
# A fresh C8 plan has no measured time model. Set an explicit time, or measure
# a pilot and pass tools/make_cost_model.py output to the next plan.

# Optional per-node pack reuse. Use a site-approved node-local path shared by
# your array elements on that node, not the shared project filesystem and not
# a job-private SLURM_TMPDIR. Cache entries are retained between jobs; remove
# this directory only after every job that uses it has finished.
# export C8_STAGE=1
# export C8_PACK_CACHE="/local/scratch/$(id -un)/c8-pack-cache"
# export C8_MERGE_WORKERS=4
# C8_MERGE_WORKERS increases both merge parallelism and merge CPU allocation.
