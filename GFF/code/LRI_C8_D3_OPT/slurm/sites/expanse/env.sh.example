# The environment of the independent C8(3) package on Expanse (docs/CLUSTERS.md). Copy to ~/c8opt/env.sh. Every job
# script sources it ($C8OPT_ENV_SETUP), so it must work in a non-interactive shell; no `set -u` in here. Every setup
# step returns 1 on failure, and the last line sets C8OPT_ENV_COMPLETE: the job scripts clear that marker before
# sourcing and refuse to run without it (slurm/site.sh c8opt_check_env).
module purge || return 1
module load cpu/0.21.2a gcc/13.3.0 || return 1
module load slurm/expanse/23.02.7 || return 1
# Spack Boost 1.77 (headers only) and GMP 6.2.1. The Spack boost modules set only BOOST_ROOT, so the include path is
# given explicitly, and GMP is found by an rpath (no LD_LIBRARY_PATH needed at run time).
export C8OPT_BOOST=/cm/shared/apps/spack/0.17.3/cpu/b/opt/spack/linux-rocky8-zen2/gcc-10.2.0/boost-1.77.0-bbnd4wnz3ueozpqlp2sz6rhsi2o2tuzn
export C8OPT_GMP=/cm/shared/apps/spack/0.21.2/cpu/a/opt/spack/linux-rocky8-zen2/gcc-13.3.0/gmp-6.2.1-eywq454gcb355knxklm3gnfrkmj3nscw
export CPPFLAGS="-I$C8OPT_BOOST/include -I$C8OPT_GMP/include"
export LDFLAGS="-L$C8OPT_GMP/lib -Wl,-rpath,$C8OPT_GMP/lib"
# The venv, made once on the login node (python3 3.11 from the c8d3 venv or a python/3.11 module):
#   python3.11 -m venv ~/c8opt/venv && ~/c8opt/venv/bin/pip install numpy==2.3.5 scipy==1.17.0 mpmath==1.3.0 sympy==1.14.0
source "$HOME/c8opt/venv/bin/activate" || return 1
export C8OPT_PYTHON="$HOME/c8opt/venv/bin/python3"
export C8OPT_SITE=expanse
export C8OPT_ROOT=<SCRATCH>/temp_project/c8opt   # runs/, logs/, evidence/, ledger, seeds (Lustre)
export C8OPT_PACKAGE=$C8OPT_ROOT/pkg/LRI_C8_D3_OPT
export C8OPT_ENV_SETUP=$HOME/c8opt/env.sh
# Admission (tools/submit.py) runs under the c8d3 package's session lock (the c8d3 root's locks/c8d3.lock on Lustre). One
# package per site and class: c8opt admits nothing in a class (compute, shared) while a c8d3- job of that class is
# live. The c8d3 submitter in turn refuses normal-QOS admissions while any foreign job of the user is live.
# Classes (H7E-R): compute jobs are normal QOS (own run/sub caps, session 11/27, the user's 22 running / 54 submitted,
# and the <ACCOUNT> account's 32 running, other users included); shared-partition jobs have their own class (own cap,
# session 32 live); compute nodes in development (own, session 4).
export C8OPT_RUN_CAP=4 C8OPT_SUB_CAP=8 C8OPT_COMPUTE_NODE_CAP=2 C8OPT_SHARED_CAP=8
export C8OPT_SESSION_RUN_CAP=11 C8OPT_SESSION_SUB_CAP=27 C8OPT_SESSION_COMPUTE_NODE_CAP=4 C8OPT_SESSION_SHARED_CAP=32
export C8OPT_USER_RUN_CAP=22 C8OPT_USER_SUB_CAP=54 C8OPT_ACCOUNT_RUN_CAP=32
# export C8OPT_NODE_HOURS_CAP=<approved>
export C8OPT_FOREIGN_SEED_LOGS=<SCRATCH>/temp_project/c8d3/forbidden_seeds.json
export C8OPT_ENV_COMPLETE=expanse   # keep last: reached only when every step above succeeded
