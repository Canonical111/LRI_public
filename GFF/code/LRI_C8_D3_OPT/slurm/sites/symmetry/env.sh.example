# The environment of the independent C8(3) package on symmetry (docs/CLUSTERS.md). Copy to ~/c8opt/env.sh. Every job
# script sources it ($C8OPT_ENV_SETUP), so it must work in a non-interactive shell; no `set -u` in here. Every setup
# step returns 1 on failure, and the last line sets C8OPT_ENV_COMPLETE: the job scripts clear that marker before
# sourcing and refuse to run without it (slurm/site.sh c8opt_check_env).
source /etc/profile.d/modules.sh || return 1
module load boost/1.77.0 python/3.11 || return 1   # boost: headers through CPATH; system GCC 11.4 and GMP 6.2.1 (multiarch)
export PATH=/cm/shared/apps/slurm/current/bin:$PATH
# The venv, made once on the login node:
#   python3.11 -m venv ~/c8opt/venv && ~/c8opt/venv/bin/pip install numpy==2.3.5 scipy==1.17.0 mpmath==1.3.0 sympy==1.14.0
# (requirements-tested.txt without pynauty, which only graph regeneration needs)
source "$HOME/c8opt/venv/bin/activate" || return 1
export C8OPT_PYTHON="$HOME/c8opt/venv/bin/python3"
export C8OPT_SITE=symmetry
export C8OPT_ROOT=<SCRATCH>/c8opt         # runs/, logs/, evidence/, ledger.jsonl, seeds.jsonl (shared BeeGFS)
export C8OPT_PACKAGE=$C8OPT_ROOT/pkg/LRI_C8_D3_OPT   # the unpacked package (bin/ is built in place by slurm/build.sh)
export C8OPT_ENV_SETUP=$HOME/c8opt/env.sh
# Admission (tools/submit.py) runs under the c8d3 package's session lock (<HOME>/c8d3/locks/c8d3.lock). One
# package per site and class: c8opt admits no AMD-pool job while a c8d3- AMD-pool job is live. Do not submit c8d3 jobs
# while c8opt AMD-pool jobs are live: the pinned c8d3 tools cannot see them (docs/CLUSTERS.md). C8OPT_AMD_CAP is this
# package's AMD-pool node cap; C8OPT_SESSION_AMD_CAP is the session's DECISIONS share (H7 4, or a window's split). Neither
# has a default. The node-hour cap is the approved budget of this package (reserved node-hours over
# $C8OPT_ROOT/ledger.jsonl). Seeds already used by the c8d3 package are refused too.
# export C8OPT_AMD_CAP=1 C8OPT_SESSION_AMD_CAP=4
# Nodes found later not to be EPYC 7543 (a 68 exit of the CPU guard), added to the built-in exclusions:
# export C8OPT_AMD_EXCLUDE_EXTRA=cnNNN,...
# export C8OPT_NODE_HOURS_CAP=<approved>
export C8OPT_FOREIGN_SEED_LOGS=<SCRATCH>/c8d3/forbidden_seeds.json
export C8OPT_ENV_COMPLETE=symmetry   # keep last: reached only when every step above succeeded
