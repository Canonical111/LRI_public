# Environment for the C8(3) independent-check templates (public/slurm/*.slurm). Copy to env.sh next to this file,
# fill the placeholders, and keep the last line: the job scripts refuse to run without C8_ENV_OK=1.
# Production (Expanse, 2026-10-10/11): GCC 13.3.0, Boost 1.77 headers, GMP 6.2.1, Python 3.11.9 with numpy 2.3.5,
# scipy 1.17.0, mpmath 1.3.0 (public/requirements.txt).
<LOAD_MODULES>                                  # e.g. module load gcc/13.3.0 ; a site may need nothing here
export CPPFLAGS="-I<BOOST_ROOT>/include -I<GMP_ROOT>/include"
export LDFLAGS="-L<GMP_ROOT>/lib -Wl,-rpath,<GMP_ROOT>/lib"
source <VENV>/bin/activate                       # python3 -m venv <VENV>; pip install -r public/requirements.txt
export C8_PYTHON=<VENV>/bin/python3
export C8_PACKAGE=<GFF>/code/LRI_C8_D3_OPT       # this package, on a filesystem every node sees
export C8_ROOT=<RUN_ROOT>                        # campaign and dispatch directories (shared filesystem)
export C8_LOCAL_SCRATCH=<SCRATCH>                # node-local disk, e.g. /scratch/$USER; never the shared filesystem
export C8_ENV_OK=1
