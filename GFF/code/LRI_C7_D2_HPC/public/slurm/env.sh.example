# Environment for LRI_C7_D2_HPC (fb64c47) on a Slurm cluster. Copy, edit, and point C7_ENV_SETUP at the copy.
# The 2026 production (symmetry, Perimeter Institute) used: system GCC 11.4 (Ubuntu 22.04), the boost/1.77.0 module
# (headers only), system GMP 6.2.1, and a Python 3.11 venv with numpy 2.3.5, scipy 1.17.1, mpmath 1.3.0, sympy 1.14.0.
# With exactly that toolchain `make && make gmp` reproduces the production binaries byte for byte
# (bin/c7d2_gmp sha256 7e3c8c922bbbc70f0a15752ca23147acc360305ff4a947004484cce3024fe8c3).
# Boost: some module systems set only BOOST_ROOT; then the compiler silently uses /usr/include. Export
# CPATH=$BOOST_ROOT/include. Boost 1.66 does not compile this kernel; 1.77 and 1.86 do.
source /etc/profile.d/modules.sh            # site specific
module load boost/1.77.0 python/3.11         # site specific: Boost >= 1.77 headers, Python >= 3.10
# export CPATH=$BOOST_ROOT/include           # if the Boost module does not set an include path
source <HOME>/c7d2_venv/bin/activate         # venv with: pip install -r requirements.txt
