# Public targets for Resummation/code/resum_d1: the d = 1 conformal Borel resummation with the short-range series
# imposed through C^SR_8 (K = 8) and the final C8(1). The scripts and records ship verbatim from the production folder
# (layout kept: baseline/, inputs/, update_2026-10-12/, update_2026-10-13/, update_2026-10-14/); public/ is added.
# Run from this folder:  make -f public.mk test | replay | replay-full | figures | clean
#
#   test         public/selftest_d1.py: the C8(1) switch, three points of the baseline recomputed with the verbatim
#                code against the shipped curve, the K = 4 control against the 2026-10-07 table, the rounding rule.
#                Seconds; Python >= 3.10, numpy, scipy, mpmath.
#   replay       public/replay_d1.py: every quoted d = 1 number of this package and the 22 resummed values of tab:num1
#                from the shipped records, the plotted data against the curve table, and the two derived tables
#                regenerated byte for byte from the frozen inputs in ../../data/inputs. Seconds.
#   replay-full  public/replay_full_d1.py: reruns the verbatim chain (update_2026-10-13/C8_1_ext/run_chain.sh) in a
#                copy under $(WORK)/full, compares all 40 outputs with the shipped ones (tolerances in the script) and
#                recomputes the quoted numbers from the rerun. About 2 min on one core, < 1 GB; needs matplotlib.
#   figures      rebuilds 01_methods{,_clean}.pdf with Wolfram Language (wolframscript and a TeX installation for
#                MaTeX) in a copy under $(WORK)/figures; the authors render on a desktop, not through Slurm.
#                The shipped PDFs are in ../../results/figures/; replay checks the plotted data, not the pixels.

PY      ?= python3
WORK    ?= .work
export PYTHONDONTWRITEBYTECODE = 1
export OPENBLAS_NUM_THREADS = 1
export OMP_NUM_THREADS = 1
export MKL_NUM_THREADS = 1

.PHONY: help test replay replay-full figures clean
help:
	@sed -n '1,21p' public.mk

test:
	$(PY) public/selftest_d1.py

replay:
	$(PY) public/replay_d1.py --work $(WORK)

replay-full:
	$(PY) public/replay_full_d1.py --work $(WORK)

figures:
	rm -rf $(WORK)/figures && mkdir -p $(WORK)/figures
	rsync -a --exclude public/ --exclude .work/ ./ $(WORK)/figures/
	cd $(WORK)/figures && LRI_C8_1=final wolframscript -file "$$PWD/run_plot.wls" "$$PWD/plot_lri_comparisons.wl"
	@echo "figures in $(WORK)/figures/figures/ (01_methods{,_clean}.pdf; 02-04 are rendered too and are not used by the paper)"

clean:
	rm -rf $(WORK)
