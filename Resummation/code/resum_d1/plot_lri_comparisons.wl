(* 1d LRI comparison figures 01-04, updated 2026-10-12 (evening) for the K=8 baseline; Figure 01 simplified 2026-10-13.
   x = Delta_sigma; thermal dimension = Delta_epsilon; epsilon = 1 - 4 x; v = 1 - 2 Sqrt[x].
   Baseline: endpoint-v conformal Borel CB8, N=8, b_L=3, alpha=0, with the short-range series imposed through
   C^SR_8 (K=8; update_2026-10-12/sr_endpoint.py, generalized in update_2026-10-12/pipeline_K8/cbk.py).
   Archived control: the same with C^SR_4 (K=4), which reproduces the archived tables to <= 1e-15.
   Gray band: union of the core prescription bands (N=6-8, b_L=2,3,4, alpha=-1,0,1) for K=5..8 (sensitivity,
   not a confidence interval). PB[5/3] (b_L=3) is admissible for K=4..7 only; no K=8 PB is shown.
   References: update_2026-10-12/references_refreshed.csv (final HT from dens_v1, NRG flagged at Delta_sigma>=0.225)
   plus six literature MC rows; HT at x=0.001 is not displayed. Open markers: HT without a continuum value,
   flagged NRG, MC with a status other than ACCEPTED, literature MC.
   Figure 01 (since 2026-10-13) shows only two resummation curves: the K=8 CB8 baseline with the K=5..8 envelope
   (sensitivity band) and the GFF-only CB8 (direct, in epsilon; left panel only). The archived K=4 curves, its core band
   and all PB curves were removed from 01; they remain in 02-04. Previous 01: history/clean_curves_before_20261013/.
   Figure 04 (since 2026-10-13): the K=8 right panel assumes C9_hyp = C9 predicted by CB from the K=8 baseline
   (-2.185071269e8, its own ninth-order re-expansion; update_2026-10-12/pipeline_K8/run_c9_cbK8ref.py), read from
   update_2026-10-13/fig04_c9_inputs.json; its CB8 -> CB9 shift is therefore identically zero. The K=4 row keeps the
   archived C9_ref = -2.190506633e8 (K=4 PB[5/3]) and is unchanged. 02 and 03 are unchanged.
   Input: update_2026-10-12/pipeline_K8/plot_data_1d_K8.json (all curves recomputed by the pipeline).
   Exports: figures/{01_methods,02_instanton,03_stability,04_precision}{,_clean}.{pdf,png};
            update_2026-10-12/pipeline_K8/render/diagnostics_1d_K8.json.
   Previous version (K=4 baseline, archived inputs): history/1d_PB_K4_baseline_20261012/plot_lri_comparisons.wl.
   Run: wolframscript -file /absolute/path/run_plot.wls /absolute/path/this.wl
   This reusable file returns normally; run_plot.wls owns kernel shutdown.
   2026-10-13 (afternoon), C8(1) FINAL = 8059766.723129955 +- 17000 ((8.060 +- 0.017) x 10^6, condensed note fa71533):
   environment LRI_C8_1 = final (default) reads update_2026-10-13/C8_1_ext/{pipeline_K8/plot_data_1d_K8.json,
   fig04_c9_inputs.json}, writes figures/ and C8_1_ext/render/diagnostics_1d_K8.json, and uses the new presentation:
   01 without the K=5..8 band (its width is stated in the caption), every _clean variant with the legend (no title,
   no caption lines), caption numbers (C8 allowance, C9 values, envelope widths) taken from the input data, panel
   ranges of 02 (top) and 04 (left) fitted to the new data, and Figure 04's K=4 row evaluated with the current inputs
   (final C8(1), allowance 17000) while its C9_hyp stays the archived scenario value -2.190506633e8 (stated in the
   caption). LRI_C8_1 = previous reads C8_1_ext/repro_previous/ (the previous-C8 inputs regenerated by run_chain.sh)
   and reproduces the previous figures exactly (old presentation), writing to C8_1_ext/repro_previous/figures/.
   Previous version of this script and figures: history/C8_1_before_ext_20261013/.
   2026-10-13 (late evening), NRG rev 2: with LRI_C8_1 = final the references come from
   update_2026-10-13/references_nrg_rev2.csv (update_2026-10-13/refresh_nrg_rev2.py): NRG values = settled late-window
   estimator, errors = linear sum of chain-depth, K/n_b and Lambda errors (not a standard deviation); Delta_sigma = 0.225,
   0.24, 0.249 are 'not converged in chain depth' (open, settled value, no error bar, not used in the comparison). The
   'flagged' NRG label of the previous version is withdrawn. Previous figures: history/NRG_rev2_before_20261013/. *)

Begin["LRIPlot`"];
$HistoryLength = 0;
base = Quiet@Check[If[$InputFileName =!= "",
   DirectoryName[ExpandFileName[$InputFileName]], NotebookDirectory[]], Directory[]];
Needs["MaTeX`", FileNameJoin[{base, "vendor", "MaTeX", "MaTeX.m"}]];
c8mode = Environment["LRI_C8_1"]; If[! StringQ[c8mode] || StringTrim[c8mode] === "", c8mode = "final"];
c8mode = ToLowerCase[StringTrim[c8mode]]; newStyle = (c8mode =!= "previous");
extDir = FileNameJoin[{base, "update_2026-10-13", "C8_1_ext"}];
inRoot = If[newStyle, extDir, FileNameJoin[{extDir, "repro_previous"}]];

result = Catch[Module[
 {raw, meta, curve, abl, refs, held, prec, c9, outdir, recdir, purple, orange, blue, green, brown, gray, black, teal, rose,
  lightgray, envgray, kcol, kdash, xTicks, makeMethods, makeInstanton, makeStability, makePrecision, exports = {},
  plots, figure, cleanFigure, config, counts, diagnostics, numericPattern, shown, checks = <||>},

 fail[tag_, detail_] := Throw[Failure[tag, <|"Detail" -> detail|>], "LRIPlotFailure"];
 require[test_, detail_] := If[! TrueQ[test], fail["Validation", detail]];
 require[MemberQ[{"final", "previous"}, c8mode], {"LRI_C8_1 must be final or previous", c8mode}];
 numericPattern = RegularExpression["[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?"];
 signedInteger[s_String] := If[StringStartsQ[s, "-"], -1, 1] * FromDigits[StringTrim[s, "+" | "-"]];
 number[s_String] := number[s] = Module[{parts, mant, exponent, sign, digits, fraction},
   require[StringMatchQ[s, numericPattern], {"Bad numeric token", s}];
   parts = StringSplit[ToLowerCase[s], "e"];
   exponent = If[Length[parts] == 2, signedInteger[parts[[2]]], 0];
   sign = If[StringStartsQ[parts[[1]], "-"], -1, 1];
   mant = StringTrim[parts[[1]], "+" | "-"];
   fraction = If[StringContainsQ[mant, "."], StringLength[mant] - First@First@StringPosition[mant, "."], 0];
   digits = StringDelete[mant, "."];
   N[sign FromDigits[digits] 10^(exponent - fraction)]];
 num[row_Association, key_String] := With[{v = row[key]},
   Which[StringQ[v], number[v], NumericQ[v], N[v], True, fail["Validation", {"Not numeric", key, v}]]];
 present[row_, key_] := KeyExistsQ[row, key] && row[key] =!= "" && row[key] =!= Null;

 raw = Import[FileNameJoin[{inRoot, "pipeline_K8", "plot_data_1d_K8.json"}], "RawJSON"];
 require[AssociationQ[raw], "JSON import"];
 c9fig = Import[FileNameJoin[{inRoot, "fig04_c9_inputs.json"}], "RawJSON"];
 require[AssociationQ[c9fig] && Length[c9fig["c9"]] == 2008, "Figure 04 C9 input (fig04_c9_inputs.json)"];
 {meta, curve, abl, refs, held, prec, c9} = Lookup[raw, {"meta", "curve", "ablation", "references", "held_out", "precision", "c9"}];
 require[Length /@ {curve, abl, refs, held, prec, c9} == {1004, 502, 49, 18, 2008, 2008},
   {"Source row counts changed: inspect the new input before plotting", Length /@ {curve, abl, refs, held, prec, c9}}];
 needKeys[rows_, keys_] := require[AllTrue[rows, Function[r, AllTrue[keys, KeyExistsQ[r, #] &]]], {"Missing columns", keys}];
 needKeys[curve, {"x", "CB8_K8", "direct_CB8", "env_lo", "env_hi"}];
 needKeys[abl, Join[{"x", "PB53_n8_K4", "PB53_n8_K5", "PB53_n8_K6", "PB53_n8_K7", "PB42_n6_K8", "PB52_n7_K8",
   "eps_PB53_n8_K4", "eps_CB_n8_K4"}, Flatten@Table["CB_n" <> ToString[n] <> "_b" <> ToString[b] <> "_K" <> ToString[k],
   {n, 6, 8}, {b, {0, 2, 3, 4}}, {k, {4, 8}}]]];
 require[! AnyTrue[abl, KeyExistsQ[#, "PB53_n8_K8"] &], "A K=8 PB[5/3] column must not exist"];
 needKeys[refs, {"method", "x", "y", "error", "stat", "status", "method_minus_K8", "method_minus_K4", "displayed"}];
 require[And @@ (OrderedQ[num[#, "x"] & /@ #] & /@ {curve, abl}), "Unsorted x grid"];
 require[meta["PB53_n8_admissible_K"] == {4, 5, 6, 7}, "PB[5/3] admissibility changed"];
 c8 = meta["C8_1"]; require[AssociationQ[c8] && c8["mode"] === c8mode, {"C8(1) mode of the input differs from LRI_C8_1", c8, c8mode}];
 require[If[newStyle, c8["C8"] === "8059766.723129955" && c8["allowance"] == 17000, c8["C8"] === "8066723.342964563" && c8["allowance"] == 33000],
   {"Unexpected C8(1) input", c8}];
 (* caption statements that depend on the order-8 Pade admissibility (checked against the data) *)
 require[meta["eps_PB53_n8_admissible_K"] == {4, 6, 7} && meta["PB_N8_b3_admissible_shapes_endpoint_v"]["8"] == {"[3/5]"} &&
   meta["PB_rule_selected_endpoint_v_b3"]["endpoint_v_K8_n7_b3"] == "[3/4]", "Figure 02/03 admissibility statements differ from the data"];
 fix[v_, d_] := ToString[NumberForm[N[Round[v, 10^-d]], {d + 3, d}]];
 sci[v_, d_] := Module[{e = Floor[Log10[Abs[v]]], m}, m = v/10^e; If[Round[m, 10^-d] >= 10, e = e + 1; m = m/10];
   ToString[NumberForm[N[Round[m, 10^-d]], {d + 1, d}]] <> "\\times10^{" <> ToString[e] <> "}"];
 c8TeX = "C_8(1)=(8.060\\pm0.017)\\times10^6";
 counts = Counts[(#["method"] &) /@ refs];
 require[counts == <|"HT" -> 13, "NRG" -> 13, "MC" -> 17, "MC_literature" -> 6|>, {"Reference counts", counts}];
 shown = Select[refs, TrueQ[#["displayed"]] &];
 require[Length[shown] == 48 && ! MemberQ[(Abs[num[#, "x"] - .001] < 10^-12 && #["method"] == "HT") & /@ shown, True],
   "Expected 48 displayed points without HT at x=0.001"];

 xy[rows_, key_] := ({num[#, "x"], num[#, key]} & /@ rows);
 difference[rows_, first_, second_, factor_: 1] := ({num[#, "x"], factor (num[#, first] - num[#, second])} & /@ rows);
 scaled[rows_, key_, factor_] := ({num[#, "x"], factor num[#, key]} & /@ rows);

 purple = RGBColor[0.48, 0.24, 0.68]; orange = RGBColor[0.85, 0.39, 0.08];
 blue = RGBColor[0.122, 0.467, 0.706]; green = RGBColor[0.12, 0.52, 0.38]; brown = RGBColor[0.55, 0.35, 0.12];
 gray = RGBColor[0.40, 0.44, 0.49]; black = GrayLevel[0.12]; lightgray = GrayLevel[0.64]; envgray = GrayLevel[0.45];
 (* 2026-10-18: one color per published MC reference, the same as in Figure 06 (plot_lri_2d3d.wl); none is a method color *)
 teal = RGBColor[0.00, 0.58, 0.60]; rose = RGBColor[0.84, 0.33, 0.58];
 require[teal =!= rose && ! IntersectingQ[{teal, rose}, {purple, orange, blue, green, black, lightgray, RGBColor[0.80, 0.12, 0.18]}],
   "published MC colors must differ from each other and from the method colors"];
 kcol = <|4 -> orange, 5 -> blue, 6 -> green, 7 -> brown, 8 -> purple|>;
 kdash = <|4 -> {7, 4}, 5 -> {2, 3}, 6 -> {5, 2, 1, 2}, 7 -> {}, 8 -> {}|>;
 tex[s_, size_: 16] := tex[s, size] = Module[{g},
   g = MaTeX`MaTeX[s, FontSize -> size, "Preamble" -> {"\\usepackage{color,txfonts}"}];
   require[Head[g] === Graphics, {"MaTeX failed", s}]; g];
 ticks[vals_] := ({N[#], tex[If[IntegerQ[#] || # == Round[#], Round[#], #], 14]} & /@ vals);
 xTicks = ticks[{0, .05, .10, .15, .20, .25}];
 stroke[col_, dash_: {}, th_: 2.1] := Directive[col, AbsoluteThickness[th], AbsoluteDashing[dash]];
 line[points_, col_, dash_: {}, th_: 2.1] := {stroke[col, dash, th], Line[points]};
 band[low_, high_, col_, op_: 0.13] := {col, Opacity[op], EdgeForm[None], Polygon[Join[low, Reverse[high]]]};
 zero[xrange_, col_: GrayLevel[.65], th_: .7] := {col, AbsoluteThickness[th], Line[{{First[xrange], 0}, {Last[xrange], 0}}]};
 marker[col_, shape_, filled_: True] := Graphics[
   {EdgeForm[Directive[col, AbsoluteThickness[1.2]]], FaceForm[If[filled, col, White]],
    Switch[shape, "square", Rectangle[{-.8, -.8}, {.8, .8}],
      "diamond", Polygon[{{0, 1}, {1, 0}, {0, -1}, {-1, 0}}],
      "triangle", Polygon[{{0, 1}, {-.9, -.7}, {.9, -.7}}],
      "invtriangle", Polygon[{{0, -1}, {-.9, .7}, {.9, .7}}], _, Disk[{0, 0}, .8]]},
   PlotRange -> {{-1.1, 1.1}, {-1.1, 1.1}}, ImagePadding -> 0, ImageSize -> 11];
 markAt[pos_, col_, shape_, filled_: True] := Inset[marker[col, shape, filled], pos, Center, Scaled[.017]];
 errorAt[x_, y_, e_, col_, thick_: 1., cap_: 3] :=
   {col, AbsoluteThickness[thick], Line[{{x, y - e}, {x, y + e}}],
    Line[{Offset[{-cap, 0}, {x, y - e}], Offset[{cap, 0}, {x, y - e}]}],
    Line[{Offset[{-cap, 0}, {x, y + e}], Offset[{cap, 0}, {x, y + e}]}]};
 refColor[r_] := Switch[r["method"], "HT", green, "NRG", If[newStyle, orange, gray],
   "MC", If[StringStartsQ[r["status"], "ACCEPTED"], black, lightgray], "MC_literature", If[newStyle, If[StringStartsQ[r["source"], "Uzelac"], rose, teal], blue]];
 (* 2026-10-13 evening: published MC distinguished by source as in Figure 06 (Angelini et al. triangle; Uzelac et al. inverted triangle);
    since 2026-10-18 NRG in orange (was gray) and one color per reference: Angelini teal, Uzelac rose (they were blue and orange,
    then briefly one neutral gray) *)
 refShape[r_] := Switch[r["method"], "HT", "square", "NRG", "circle", "MC", "diamond", "MC_literature", If[newStyle && StringStartsQ[r["source"], "Uzelac"], "invtriangle", "triangle"]];
 require[Sort[Union[#["source"] & /@ Select[refs, #["method"] == "MC_literature" &]]] == {"Angelini-Parisi-Ricci-Tersenghi 2014", "Uzelac-Glumac-Anicic 2001"}, "1d published MC sources changed"];
 filledQ[r_] := Switch[r["method"], "HT", MemberQ[{"final", "one_sided"}, r["status"]],
   "NRG", ! MemberQ[{"flagged", "not_converged"}, r["status"]], "MC", StringStartsQ[r["status"], "ACCEPTED"], _, False];
 (* NRG rev 2 (2026-10-13): final points carry the linear error sum; the three not-converged points have no error *)
 nrgStatusOK[rows_] := With[{nrg = Select[rows, #["method"] == "NRG" &]}, If[newStyle,
   AllTrue[nrg, If[num[#, "x"] <= .2 + 10^-12, #["status"] == "final" && present[#, "error"], #["status"] == "not_converged" && ! present[#, "error"]] &],
   AllTrue[nrg, If[num[#, "x"] <= .2 + 10^-12, #["status"] == "reported", #["status"] == "flagged"] && present[#, "error"] &]]];
 require[nrgStatusOK[refs], "NRG statuses/errors differ from the caption (rev 2: final x<=0.2, not_converged x>=0.225 without error)"];
 halfBar[r_] := Max[If[present[r, "error"], num[r, "error"], 0], If[present[r, "stat"], num[r, "stat"], 0]];
 (* rows: references to draw; residual: plot method - CB8(K=8) times 1000 *)
 referenceLayer[rows_, residual_: False] := Flatten[Map[Function[r, Module[{x, y, col, scale, err, stat, extra},
   x = num[r, "x"]; scale = If[residual, 1000, 1];
   y = If[residual, 1000 num[r, "method_minus_K8"], num[r, "y"]]; col = refColor[r];
   err = If[present[r, "error"], errorAt[x, y, scale num[r, "error"], col, .9, 3], {}];
   stat = If[present[r, "stat"], errorAt[x, y, scale num[r, "stat"], col, 1.8, 1.5], {}];
   extra = If[r["status"] == "one_sided", {col, AbsoluteThickness[.9], AbsoluteDashing[{2, 2}],
       Line[{{x, y - scale num[r, "error"]}, {x, y - scale (num[r, "error"] + 5*^-4)}}]}, {}];
   {err, stat, extra, markAt[{x, y}, col, refShape[r], filledQ[r]]}]], rows], 1];
 inWindow[rows_, residual_, {x0_, x1_}, {y0_, y1_}] := AllTrue[rows, Function[r, Module[{x, y, e, scale},
   scale = If[residual, 1000, 1]; x = num[r, "x"];
   y = If[residual, 1000 num[r, "method_minus_K8"], num[r, "y"]];
   e = scale (halfBar[r] + If[r["status"] == "one_sided", 5*^-4, 0]);
   x0 <= x <= x1 && y0 <= y - e && y + e <= y1]]];

 panel[prims_, xr_, yr_, ylabel_, title_, yticks_, clean_: False, xticks_: Automatic, xlabel_: "\\Delta_\\sigma"] :=
   Graphics[prims, Frame -> True, Axes -> False, FrameStyle -> Directive[black, AbsoluteThickness[1.]],
    FrameLabel -> {{tex[ylabel, 21], None}, {tex[xlabel, 21], None}},
    FrameTicks -> {{ticks[yticks], None}, {If[xticks === Automatic, xTicks, xticks], None}},
    PlotLabel -> If[clean, None, tex[title, 17]],
    PlotRange -> {xr, yr}, PlotRangePadding -> None, PlotRangeClipping -> True,
    GridLines -> {None, yticks}, GridLinesStyle -> Directive[GrayLevel[.91], AbsoluteThickness[.5]],
    ImageSize -> 575, AspectRatio -> .68, ImagePadding -> {{76, 18}, {61, If[clean, 12, 36]}}, Background -> White];
 lineKey[col_, dash_, text_, th_: 2.1] := {Graphics[{stroke[col, dash, th], Line[{{0, 0}, {1, 0}}]},
   ImageSize -> {40, 14}, ImagePadding -> 1, PlotRange -> {{0, 1}, {-.2, .2}}], tex[text, 14]};
 pointKey[col_, shape_, filled_, text_] := {marker[col, shape, filled], tex[text, 14]};
 patchKey[col_, text_, opacity_: .2] := {Graphics[{col, Opacity[opacity], Rectangle[]}, ImageSize -> {36, 12}], tex[text, 14]};
 keyGrid[entries_, ncol_: 3] := Grid[Partition[PadRight[(Row[#, Spacer[6]] & /@ entries),
   ncol Ceiling[Length[entries]/ncol], ""], ncol], Alignment -> Left, Spacings -> {2, .6}];
 assemble[panelRows_, title_, keys_, notes_, clean_] := If[clean,
   If[newStyle, Column[{Grid[panelRows, Spacings -> {1.5, 1.2}], keyGrid[keys]}, Alignment -> Center, Spacings -> .8],
     Grid[panelRows, Spacings -> {1.5, 1.2}]],
   Column[Join[{tex[title, 23], Grid[panelRows, Spacings -> {1.5, 1.2}], keyGrid[keys]}, (tex[#, 13] & /@ notes)],
     Alignment -> Center, Spacings -> .8]];
 (* 2026-10-13 evening: one entry per method with its filled and open marker; the caption says what each means *)
 pairKey[colF_, colO_, shape_, text_] := {Row[{marker[colF, shape, True], marker[colO, shape, False]}, Spacer[3]], tex[text, 14]};
 refKeys = If[newStyle, {pairKey[green, green, "square", "\\text{HT}"], pairKey[orange, orange, "circle", "\\text{NRG}"],
    pairKey[black, lightgray, "diamond", "\\text{MC (this work)}"]}, {pointKey[green, "square", True, "\\text{HT: final}"],
   pointKey[green, "square", False, "\\text{HT: no continuum value}"],
   pointKey[gray, "circle", True, "\\text{NRG}"], pointKey[gray, "circle", False, "\\text{NRG: flagged near }s=1/2"],
   pointKey[black, "diamond", True, If[newStyle, "\\text{MC (this work)}", "\\text{MC}"]], pointKey[lightgray, "diamond", False, If[newStyle, "\\text{MC (this work)}", "\\text{MC}"]]}];

 (* ---------------- 01: methods (2026-10-13: baseline CB8 with its band, and GFF-only CB8) ---------------- *)
 makeMethods[clean_] := Module[{p1, p2, keys, resRows, leftCurves, bandRes, envWidth, w, iw, leftRange, cb3Expected, rightRange, rightTicks, litRes, litCut},
   (* 2026-10-13: CB3 (GFF only, C_0..C_3) reaches 0.455 near Delta_sigma = 0, so the left frame starts at 0.44 *)
   leftRange = If[newStyle, {.44, 1.02}, {.465, 1.02}];
   If[newStyle,     (* 2026-10-13: the K=5..8 band is not drawn; the three curves must lie inside the left panel *)
     cb3Expected = {{.0005, .4555}, {.05, .4590}, {.1, .4636}, {.15, .4700}, {.2, .4799}, {.249, .4993}};
     checks["01_CB3_vs_gff_only_v_values"] = AllTrue[cb3Expected, Function[e, Abs[num[First@Select[curve, Abs[num[#, "x"] - e[[1]]] < 10^-12 &], "direct_CB3"] - e[[2]]] < 5*^-5]];
     require[checks["01_CB3_vs_gff_only_v_values"], "01: CB3 differs from the gff_only_v.py values"];
     leftCurves = Join[xy[curve, "CB8_K8"], xy[curve, "direct_CB8"], xy[curve, "direct_CB3"]];
     checks["01_left_curves_in_range"] = AllTrue[leftCurves, leftRange[[1]] + .005 <= #[[2]] <= leftRange[[2]] &];
     require[checks["01_left_curves_in_range"], "01: a curve leaves its panel"],
     leftCurves = Join[xy[curve, "CB8_K8"], xy[curve, "direct_CB8"], xy[curve, "env_lo"], xy[curve, "env_hi"]];
     bandRes = Select[Join[difference[curve, "env_lo", "CB8_K8", 1000], difference[curve, "env_hi", "CB8_K8", 1000]], #[[1]] >= .02 &];
     checks["01_left_curves_and_band_in_range"] = AllTrue[leftCurves, .465 <= #[[2]] <= 1.02 &];
     checks["01_right_band_in_range"] = AllTrue[bandRes, -12 <= #[[2]] <= 12 &];
     require[checks["01_left_curves_and_band_in_range"] && checks["01_right_band_in_range"], "01: a curve or the band leaves its panel"]];
   (* envelope width (caption): K=5..8 union of the core bands, at 0.05, 0.1, 0.15 and its maximum *)
   w = (num[#, "env_hi"] - num[#, "env_lo"]) & /@ curve; iw = First@Ordering[w, -1];
   envWidth = <|"0.05" -> w[[First@FirstPosition[num[#, "x"] & /@ curve, _?(Abs[# - .05] < 10^-12 &)]]],
     "0.1" -> w[[First@FirstPosition[num[#, "x"] & /@ curve, _?(Abs[# - .1] < 10^-12 &)]]],
     "0.15" -> w[[First@FirstPosition[num[#, "x"] & /@ curve, _?(Abs[# - .15] < 10^-12 &)]]], "max" -> w[[iw]], "max_at" -> num[curve[[iw]], "x"]|>;
   checks["01_envelope_width"] = envWidth;
   p1 = panel[{If[newStyle, {}, band[xy[curve, "env_lo"], xy[curve, "env_hi"], envgray, .28]],
      line[xy[curve, "direct_CB8"], blue, {7, 3, 1.5, 3}],
      If[newStyle, line[xy[curve, "direct_CB3"], blue, {2, 2.5}, 1.4], {}],
      line[xy[curve, "CB8_K8"], purple], referenceLayer[shown]}, {0, .25}, leftRange,
     "\\Delta_{\\mathcal E}", "\\text{Full interval}", {.5, .6, .7, .8, .9, 1.}, clean];
   (* 2026-10-14 (author request): the published MC values are also shown in the right panel (new style). Their central
      values reach -22 and +17, so the frame is -25..20; the bars of Uzelac et al. at 0.05 and 0.2 and of Angelini et al. at
      0.1727 are cut at the frame (caption). Every other bar must stay inside. *)
   {rightRange, rightTicks} = If[newStyle, {{-25, 20}, {-20, -10, 0, 10, 20}}, {{-12, 12}, {-10, -5, 0, 5, 10}}];
   resRows = Select[shown, (newStyle || #["method"] =!= "MC_literature") && num[#, "x"] >= .02 &];
   litRes = Select[resRows, #["method"] === "MC_literature" &];
   checks["01_left_all_bars_in_range"] = inWindow[shown, False, {0, .25}, leftRange];
   checks["01_right_all_bars_in_range"] = inWindow[Select[resRows, #["method"] =!= "MC_literature" &], True, {.02, .25}, rightRange];
   checks["01_right_literature_centres_in_range"] = AllTrue[litRes, rightRange[[1]] + 1 <= 1000 num[#, "method_minus_K8"] <= rightRange[[2]] - 1 &];
   litCut = Sort[num[#, "x"] & /@ Select[litRes, ! inWindow[{#}, True, {.02, .25}, rightRange] &]];
   checks["01_right_literature_bars_cut_at"] = litCut;
   require[checks["01_left_all_bars_in_range"] && checks["01_right_all_bars_in_range"] && checks["01_right_literature_centres_in_range"] &&
     If[newStyle, Length[litRes] == 6 && litCut == {.05, .1727335, .2}, litRes === {}], {"01: reference error bar or value outside a panel", litCut}];
   p2 = panel[{If[newStyle, {}, band[difference[curve, "env_lo", "CB8_K8", 1000], difference[curve, "env_hi", "CB8_K8", 1000], envgray, .28]],
      zero[{.02, .25}, purple, 2.1], referenceLayer[resRows, True]}, {.02, .25}, rightRange,
     "10^3(\\Delta_{\\mathcal E}-\\Delta_{\\mathcal E}^{{\\rm CB8},\\,K=8})", "\\text{Central-region residuals}", rightTicks, clean];
   keys = Join[{lineKey[purple, {}, "\\text{CB8, }K=8\\text{ (baseline)}"]},
     If[newStyle, {}, {patchKey[envgray, "\\text{sensitivity band (}K=5\\text{--}8\\text{ envelope)}", .28]}],
     {lineKey[blue, {7, 3, 1.5, 3}, "\\text{CB8: GFF only }(\\epsilon)\\text{, left panel}"]},
     If[newStyle, {lineKey[blue, {2, 2.5}, "\\text{CB3: GFF only (three loops)}", 1.4]}, {}], refKeys,
     If[newStyle, {pointKey[rose, "invtriangle", False, "\\text{MC: Uzelac et al. (2001)}"], pointKey[teal, "triangle", False, "\\text{MC: Angelini et al. (2014)}"]},
       {pointKey[blue, "triangle", False, "\\text{Literature MC (left panel)}"]}]];
   assemble[{{p1, p2}}, "\\text{1d long-range Ising: comparison of methods, short-range series through }C^{\\rm SR}_8", keys,
    If[newStyle, {
     "\\text{Purple: CB8 in }v=1-2\\sqrt{\\Delta_\\sigma}\\text{ with the short-range series imposed through }C^{\\rm SR}_8\\ (K=8)\\text{; GFF series through }" <> c8TeX <> ".",
     "\\text{Blue, left panel: GFF series alone, CB8 (dash-dot) and CB3 (dotted, }C_0,\\ldots,C_3\\text{ only). Not drawn: dependence on prescription and on }K=5\\text{--}8\\text{, at most }" <> sci[envWidth["max"], 2] <> ".",
     "\\text{Filled: HT final values, NRG, accepted new MC. Open: HT without continuum value }(N=40)\\text{, NRG not converged in chain depth, new MC with other statuses.}",
     "\\text{Open NRG }(\\Delta_\\sigma\\geq0.225)\\text{: settled value, no error bar, not used in the comparison. HT dashed bar: one-sided error.}",
     "\\text{Published MC: quoted errors; in the right panel three of their bars are cut at the frame.}"},
    Join[If[newStyle,
     {"\\text{Baseline: endpoint-}v\\text{ CB8},\\ N=8,\\ b_{\\rm L}=3,\\ \\alpha=0,\\ v=1-2\\sqrt{\\Delta_\\sigma},\\ \\text{short-range series through }C^{\\rm SR}_8\\ (K=8);\\ A_\\epsilon=0.51406490\\ \\text{(candidate); GFF series through }" <> c8TeX <> ".",
      "\\text{Not drawn: the }K=5\\text{--}8\\text{ envelope of the core bands }(N=6,7,8;\\ b_{\\rm L}=2,3,4;\\ \\alpha=-1,0,1)\\text{, i.e. the sensitivity to the prescription and to the number }K\\text{ of imposed short-range coefficients,}",
      "\\text{has width }" <> sci[envWidth["0.05"], 2] <> ",\\ " <> sci[envWidth["0.1"], 2] <> ",\\ " <> sci[envWidth["0.15"], 2] <>
        "\\text{ at }\\Delta_\\sigma=0.05,\\ 0.1,\\ 0.15\\text{ and at most }" <> sci[envWidth["max"], 2] <> "\\ (\\Delta_\\sigma=" <> fix[envWidth["max_at"], 3] <>
        ")\\text{; not a confidence interval. No reference point selects a prescription.}"},
     {"\\text{Baseline: endpoint-}v\\text{ CB8},\\ N=8,\\ b_{\\rm L}=3,\\ \\alpha=0,\\ v=1-2\\sqrt{\\Delta_\\sigma},\\ \\text{short-range series through }C^{\\rm SR}_8\\ (K=8);\\ A_\\epsilon=0.51406490\\ \\text{(candidate)}.",
      "\\text{Gray: union of the core bands }(N=6,7,8;\\ b_{\\rm L}=2,3,4;\\ \\alpha=-1,0,1)\\text{ for }K=5\\text{--}8.\\ \\text{Sensitivity range, not a confidence interval; no reference point selects a prescription.}"}], {
     "\\text{Blue dash-dot: CB8 of the GFF series alone, resummed directly in }\\epsilon\\text{ (no short-range input); left panel only, as it leaves the residual window (see Figure 05).}",
     If[newStyle, "\\text{Blue dotted (left panel): CB3, the same direct }\\epsilon\\text{ prescription truncated at }N=3\\text{, i.e. using only }C_0,\\ldots,C_3\\text{, the coefficients known before this work.}", Nothing],
     "\\text{The archived }K=4\\text{ construction and the PB comparisons are in Figures 02--04 and in history/.}",
     "\\text{HT: density-basis final values (dashed: extra one-sided }{-5\\times10^{-4}}\\text{ at }\\Delta_\\sigma=0.075);\\ \\text{open: unstable or no continuum limit, value at }N=40;\\ \\Delta_\\sigma=0.001\\text{ omitted.}",
     "\\text{NRG open at }\\Delta_\\sigma\\geq0.225\\text{ (flagged). Literature MC errors exceed the residual window (see Figure 05).}",
     "\\text{MC: filled, accepted infinite-size values; open, other statuses (conditional, cross-check failed); systematic and statistical bars separate.}"}]], clean]];

 (* ---------------- 02: instanton information ---------------- *)
 makeInstanton[clean_] := Module[{pv, pe, pd, ph, bars, keys, heldBars, topRange, topTicks, topVals, rule},
   (* 2026-10-13: with the final C8(1) the K=4 matched difference reaches -0.549e-3; the top frames are widened *)
   {topRange, topTicks} = If[newStyle, {{-.65, .45}, {-.6, -.4, -.2, 0, .2, .4}}, {{-.55, .45}, {-.4, -.2, 0, .2, .4}}];
   topVals = Join[Flatten[Table[Last /@ difference[abl, "CB_n8_b3_K" <> ToString[k], "PB53_n8_K" <> ToString[k], 1000], {k, 4, 7}]],
     Flatten[Table[Last /@ difference[abl, "eps_CB_n8_K" <> ToString[k], "eps_PB53_n8_K" <> ToString[k], 1000], {k, {4, 6, 7}}]]];
   checks["02_top_curves_in_range"] = First[topRange] + .02 <= Min[topVals] && Max[topVals] <= Last[topRange] - .02;
   require[checks["02_top_curves_in_range"], {"02: a matched CB-PB curve leaves (or touches) its frame", MinMax[topVals]}];
   (* PB shapes named in the caption = the rule-selected held-out approximants of the data *)
   rule[k_] := (#["approximant"] & /@ SortBy[Select[held, #["method"] == "PB" && #["mode"] == "endpoint_v" && ToString[#["K"]] == k &], #["predict_C"] &]);
   require[rule["8"] == {"[4/1]", "[4/2]", "[3/4]"} && rule["4"] == {"[3/2]", "[4/2]", "[5/2]"}, {"02: held-out PB shapes differ from the caption", rule["8"], rule["4"]}];
   pv = panel[Join[{zero[{0, .25}]}, Table[line[difference[abl, "CB_n8_b3_K" <> ToString[k], "PB53_n8_K" <> ToString[k], 1000],
        kcol[k], kdash[k]], {k, 4, 7}]], {0, .25}, topRange,
     "10^3(\\Delta_{\\mathcal E}^{\\rm CB8}-\\Delta_{\\mathcal E}^{{\\rm PB}[5/3]})", "\\text{Matched in }v,\\ N=8,\\ b_{\\rm L}=3",
     topTicks, clean];
   pe = panel[Join[{zero[{0, .25}]}, Table[line[difference[abl, "eps_CB_n8_K" <> ToString[k], "eps_PB53_n8_K" <> ToString[k], 1000],
        kcol[k], kdash[k]], {k, {4, 6, 7}}]], {0, .25}, topRange,
     "10^3(\\Delta_{\\mathcal E}^{\\rm CB8}-\\Delta_{\\mathcal E}^{{\\rm PB}[5/3]})", "\\text{Matched in }\\epsilon,\\ N=8,\\ b_{\\rm L}=3",
     topTicks, clean];
   heldBars[rows_, specs_] := Map[Function[r, Module[{x, y, spec},
     spec = specs[{r["method"], r["mode"], ToString[r["K"]]}];
     x = r["predict_C"] + spec[[1]]; y = 100 r["absolute_relative_error"];
     {spec[[2]], EdgeForm[None], Rectangle[{x - spec[[3]], 0}, {x + spec[[3]], y}],
      Inset[tex[ToString[NumberForm[y, {4, 2}]], spec[[4]]], Offset[{0, 8}, {x, y}], {Center, Bottom}]}]], rows];
   pd = panel[heldBars[Select[held, #["mode"] == "direct" &],
       <|{"CB", "direct", ""} -> {-.18, purple, .13, 13}, {"PB", "direct", ""} -> {.18, orange, .13, 13}|>],
     {5.5, 8.5}, {0, 13}, "\\text{Absolute relative error }(\\%)", "\\text{Direct GFF series (independent of }K)",
     {0, 3, 6, 9, 12}, clean, {{6, tex["C_6", 16]}, {7, tex["C_7", 16]}, {8, tex["C_8", 16]}}, "\\text{Held-out coefficient}"];
   ph = panel[heldBars[Select[held, #["mode"] == "endpoint_v" &],
       <|{"CB", "endpoint_v", "8"} -> {-.3, purple, .065, 11}, {"PB", "endpoint_v", "8"} -> {-.1, orange, .065, 11},
         {"CB", "endpoint_v", "4"} -> {.1, Lighter[purple, .55], .065, 11}, {"PB", "endpoint_v", "4"} -> {.3, Lighter[orange, .55], .065, 11}|>],
     {5.5, 8.5}, {0, 13}, "\\text{Absolute relative error }(\\%)", "\\text{Endpoint }v\\text{ with }C^{\\rm SR}_{1..K}",
     {0, 3, 6, 9, 12}, clean, {{6, tex["C_6", 16]}, {7, tex["C_7", 16]}, {8, tex["C_8", 16]}}, "\\text{Held-out coefficient}"];
   keys = {lineKey[orange, kdash[4], "K=4\\text{ (archived)}"], lineKey[blue, kdash[5], "K=5"],
     lineKey[green, kdash[6], "K=6"], lineKey[brown, kdash[7], "K=7"],
     patchKey[purple, "\\text{CB: candidate instanton }A\\ (\\text{right: }K=8)", 1],
     patchKey[orange, "\\text{PB: no input }A\\ (\\text{right: }K=8)", 1],
     patchKey[Lighter[purple, .55], "\\text{CB, }K=4\\text{ (archived)}", 1], patchKey[Lighter[orange, .55], "\\text{PB, }K=4\\text{ (archived)}", 1]};
   assemble[{{pv, pe}, {pd, ph}}, "\\text{What does instanton information change? Short-range series through }C^{\\rm SR}_K", keys,
    If[newStyle, {
     "\\text{Top: CB (candidate instanton action }A\\text{) minus PB (no }A\\text{), otherwise identical. PB}[5/3]\\text{ admissible in }v\\text{ for }K=4\\text{--}7\\text{, in }\\epsilon\\text{ for }K=4,6,7\\text{; none at }K=8.",
     "\\text{Bottom: }C_6,C_7,C_8\\text{ predicted from the lower orders; bars are central-value errors (}C_8\\text{ allowance about }" <> fix[c8["allowance_percent"], 2] <> "\\%\\text{). No fit to reference data.}",
     "K=4\\text{ (archived): the archived construction with the current coefficients.}"},
    {"\\text{Top: CB and PB share coefficients, order, endpoint input }S_K\\text{, expansion variable and }b_{\\rm L}.\\ \\text{PB}[5/3]\\text{ admissible in }v\\text{ for }K=4\\text{--}7,\\ \\text{in }\\epsilon\\text{ for }K=4,6,7;\\ \\text{none at }K=8.",
     "\\text{Bottom: }C_6,C_7,C_8\\text{ predicted from orders }5,6,7\\text{ only; PB chosen by the archived near-diagonal rule }(K=8\\text{: }[4/1],[4/2],[3/4];\\ K=4\\text{: }[3/2],[4/2],[5/2]).",
     If[newStyle,
      "\\text{No fit to reference data. This compares approximation families. Bars are central-value discrepancies; the }C_8\\text{ bars use }" <> c8TeX <>
        "\\text{ (allowance about }" <> fix[c8["allowance_percent"], 2] <> "\\%).",
      "\\text{No fit to reference data. This compares approximation families. The }C_8\\text{ empirical allowance is about }" <>
        fix[c8["allowance_percent"], 2] <> "\\%;\\ \\text{bars are central-value discrepancies.}"]}
     ~Join~ If[newStyle, {"K=4\\text{ (archived): the archived construction }S_4\\text{ evaluated with the current coefficients, including the final }C_8(1)."}, {}]], clean]];

 (* ---------------- 03: stability ---------------- *)
 makeStability[clean_] := Module[{orderPanel, blPanel, colors, dashes, keys},
   colors = {green, blue, purple}; dashes = {{2, 3}, {7, 4}, {}};
   orderPanel[k_, yr_, yt_, title_] := Module[{ks = ToString[k], prims},
     prims = Join[{zero[{0, .25}]}, Flatten[Table[
       {line[difference[abl, "CB_n" <> ToString[n] <> "_b3_K" <> ks, "CB_n8_b3_K" <> ks, 1000], colors[[n - 5]], dashes[[n - 5]]],
        With[{pk = {"PB42_n6_K", "PB52_n7_K", "PB53_n8_K"}[[n - 5]] <> ks},
          If[KeyExistsQ[First[abl], pk], line[difference[abl, pk, "CB_n8_b3_K" <> ks, 1000], orange, dashes[[n - 5]]], {}]]},
       {n, 6, 8}], 1]];
     panel[prims, {0, .25}, yr, "10^3(\\Delta_{\\mathcal E}-\\Delta_{\\mathcal E}^{\\rm CB8})", title, yt, clean]];
   blPanel[k_, yr_, yt_, title_] := Module[{ks = ToString[k]},
     panel[{zero[{0, .25}],
       line[difference[abl, "CB_n8_b0_K" <> ks, "CB_n8_b3_K" <> ks, 1000], orange, {7, 4}],
       line[difference[abl, "CB_n8_b2_K" <> ks, "CB_n8_b3_K" <> ks, 1000], green],
       line[difference[abl, "CB_n8_b4_K" <> ks, "CB_n8_b3_K" <> ks, 1000], blue, {2, 3}]}, {0, .25}, yr,
      "10^3(\\Delta_{\\mathcal E}^{b_{\\rm L}}-\\Delta_{\\mathcal E}^{b_{\\rm L}=3})", title, yt, clean]];
   require[! KeyExistsQ[First[abl], "PB53_n8_K8"], "no K=8 PB[5/3]"];
   keys = Join[Flatten[Table[{lineKey[colors[[n - 5]], dashes[[n - 5]], "\\text{Left: CB},\\ N=" <> ToString[n]],
       lineKey[orange, dashes[[n - 5]], "\\text{Left: PB}" <> {"[4/2]", "[5/2]", "[5/3]"}[[n - 5]] <> ",\\ N=" <> ToString[n]]}, {n, 6, 8}], 1],
     {lineKey[orange, {7, 4}, "\\text{Right: }b_{\\rm L}=0"], lineKey[green, {}, "\\text{Right: }b_{\\rm L}=2"],
      lineKey[blue, {2, 3}, "\\text{Right: }b_{\\rm L}=4"]}];
   assemble[{{orderPanel[8, {-1.1, 1.25}, {-1, -.5, 0, .5, 1}, "K=8:\\ \\text{order dependence, endpoint }v,\\ b_{\\rm L}=3"],
       blPanel[8, {-.4, 3.4}, {0, 1, 2, 3}, "K=8:\\ \\text{Borel--Leroy dependence, CB8}"]},
      {orderPanel[4, {-1.1, 1.25}, {-1, -.5, 0, .5, 1}, "K=4\\text{ (archived): order dependence}"],
       blPanel[4, {-4, 23}, {0, 5, 10, 15, 20}, "K=4\\text{ (archived): Borel--Leroy dependence}"]}},
    "\\text{Finite-order stability and prescription dependence: }K=8\\text{ baseline (top), }K=4\\text{ archived control (bottom)}", keys,
    If[newStyle, {
     "\\text{Left: change with the order }N=6,7,8\\text{ (CB; PB }[4/2],[5/2],[5/3]\\text{ where admissible, none at }K=8,\\ N=8\\text{). Right: change with }b_{\\rm L}\\text{ for CB8.}",
     "\\text{Each row relative to its own CB8 }(b_{\\rm L}=3,\\ \\alpha=0)\\text{; }K=4\\text{ is the archived construction with the current coefficients. Not error bars.}"},
    {"\\text{PB shapes at }N=6,7,8:\\ [4/2],\\ [5/2],\\ [5/3]\\ (b_{\\rm L}=3)\\text{ where admissible. At }K=8,\\ N=8\\text{ PB}[5/3]\\text{ is not admissible (positive-real Borel pole); no PB is drawn there.}",
     "\\text{At }K=8\\text{ the archived near-diagonal rule would prefer }[3/4]\\text{ at }N=7\\text{ and admits only }[3/5]\\text{ at }N=8\\text{; these are tabulated, not drawn.}",
     "\\text{Each row is relative to its own CB8 }(\\alpha=0).\\ \\text{Vertical ranges differ between the right panels. These variations are not statistical error bars.}"}
     ~Join~ If[newStyle, {"\\text{GFF series through }" <> c8TeX <> "\\text{ (final) in both rows; }K=4\\text{ is the archived construction }S_4\\text{ with these coefficients.}"}, {}]], clean]];

 (* ---------------- 04: precision ---------------- *)
 makePrecision[clean_] := Module[{precPanel, c9Panel, keys, c9ref, imp, c9h, c9ref8, fmt, prec8, prec4, allowTeX},
   (* 2026-10-13: K=8 row referenced to C9 predicted by CB from the K=8 baseline; K=4 row unchanged *)
   c9h = c9fig["c9"];
   require[AllTrue[Transpose[{c9, c9h}], #[[1]]["K"] == #[[2]]["K"] && #[[1]]["x"] == #[[2]]["x"] &&
       If[#[[1]]["K"] == 4, Max[Abs[#[[1]]["shift_if_ref"] - #[[2]]["shift_if_ref"]], Abs[#[[1]]["resp_1pct"] - #[[2]]["resp_1pct"]],
         Abs[#[[1]]["resp_5pct"] - #[[2]]["resp_5pct"]]] < 10^-13, #[[2]]["shift_if_ref"] == 0] &],
     "04: K=4 C9 rows differ from plot_data_1d_K8.json or the K=8 shift is not identically zero"];
   precPanel[k_, yr_, yt_, title_] := Module[{rows = Select[prec, #["K"] == k &]},
     require[Length[rows] == 1004, "precision rows"];
     panel[{line[scaled[rows, "sum_before", 10^4], purple],
       line[scaled[rows, "sum_after", 10^4], green],
       line[scaled[rows, "floor_with_C8_exact", 10^4], gray, {7, 4}]},
      {0, .25}, yr, "10^4\\,\\delta\\Delta_{\\mathcal E}", title, yt, clean]];
   c9Panel[k_, yr_, yt_, title_] := Module[{rows = Select[c9h, #["K"] == k &]},
     require[Length[rows] == 1004, "c9 rows"];
     panel[{zero[{0, .25}], line[scaled[rows, "shift_if_ref", 10^3], purple, {4, 3}],
       line[scaled[rows, "resp_1pct", 10^3], blue, {4, 3}],
       line[scaled[rows, "resp_5pct", 10^3], orange, {4, 3}]},
      {0, .25}, yr, "10^3\\,\\delta\\Delta_{\\mathcal E}", title, yt, clean]];
   c9ref = number[meta["C9_reference"]]; require[Abs[c9ref/-2.190506633*^8 - 1] < 10^-9, {"C9 reference changed", c9ref}];
   imp = meta["C9_implied_by_CB8"];
   require[Abs[number[c9fig["meta"]["C9_reference"]["4"]]/c9ref - 1] < 10^-15, "04: K=4 C9 reference differs from the archived value"];
   c9ref8 = number[c9fig["meta"]["C9_reference"]["8"]];
   require[Abs[c9ref8/imp["8"] - 1] < 10^-14 && Abs[c9ref8/If[newStyle, -2.178401719*^8, -2.185071269*^8] - 1] < 10^-9, {"04: K=8 C9_hyp is not the CB8 (K=8) prediction", c9ref8}];
   {prec8, prec4} = If[newStyle, {{{0, .66}, {0, .15, .3, .45, .6}}, {{0, 2.6}, {0, .5, 1, 1.5, 2, 2.5}}},
     {{{0, 1.15}, {0, .25, .5, .75, 1}}, {{0, 4.6}, {0, 1, 2, 3, 4}}}];
   fmt[v_, n_] := ToString[NumberForm[v/10^8, {n + 1, n}]];
   checks["04_ranges"] = And @@ {
     AllTrue[Select[prec, #["K"] == 8 &], 10^4 #["sum_before"] <= prec8[[1, 2]] &], AllTrue[Select[prec, #["K"] == 4 &], 10^4 #["sum_before"] <= prec4[[1, 2]] &],
     AllTrue[Select[c9h, #["K"] == 8 &], -.3 <= 10^3 Min[#["shift_if_ref"], #["resp_5pct"]] && 10^3 Max[#["shift_if_ref"], #["resp_5pct"]] <= 2.75 &],
     AllTrue[Select[c9h, #["K"] == 4 &], -.3 <= 10^3 Min[#["shift_if_ref"], #["resp_5pct"]] && 10^3 Max[#["shift_if_ref"], #["resp_5pct"]] <= 12.2 &]};
   require[checks["04_ranges"], "04: a curve leaves its panel"];
   keys = {lineKey[purple, {}, "\\text{Left: current }C_6,C_7,C_8"],
     lineKey[green, {}, "\\text{Left: }\\delta C_8/10"],
     lineKey[gray, {7, 4}, "\\text{Left: }C_8\\text{ exact; }C_6,C_7\\text{ unchanged}"],
     lineKey[purple, {4, 3}, "\\text{Right: shift if }C_9=C_9^{\\rm hyp}"],
     lineKey[blue, {4, 3}, "\\text{Right: response to }1\\%\\,|C_9^{\\rm hyp}|"],
     lineKey[orange, {4, 3}, "\\text{Right: response to }5\\%\\,|C_9^{\\rm hyp}|"]};
   allowTeX = "\\delta C_8:" <> ToString[c8["allowance"]] <> "\\to" <> ToString[Quotient[c8["allowance"], 10]];
   assemble[{{precPanel[8, prec8[[1]], prec8[[2]], "K=8,\\ N=8:\\ \\text{reduce the }C_8\\text{ allowance tenfold}"],
       c9Panel[8, {-.3, 2.75}, {0, .5, 1, 1.5, 2, 2.5}, "K=8:\\ \\text{hypothetical }C_9=\\text{CB8 prediction}"]},
      {precPanel[4, prec4[[1]], prec4[[2]], "K=4\\text{ (archived), }N=8"],
       c9Panel[4, {-.3, 12.2}, {0, 3, 6, 9, 12}, "K=4\\text{ (archived): hypothetical }C_9"]}},
    "\\text{Coefficient precision: }C_8\\text{ and the possible value of }C_9\\text{; }K=8\\text{ (top), }K=4\\text{ archived control (bottom)}", keys,
    If[newStyle, {
     "\\text{Left: summed linear response to the coefficient allowances (}" <> allowTeX <> ",\\ \\delta C_7=41\\text{). Not a confidence interval.}",
     "\\text{Right: }C_9^{\\rm hyp}\\text{ is a scenario, not a computed coefficient. Top: }{" <> fmt[c9ref8, 3] <> "}\\times10^8\\text{, the CB prediction from the }K=8\\text{ baseline (so its shift is zero); bottom: }{" <> fmt[c9ref, 3] <> "}\\times10^8\\text{, the archived }K=4\\text{ PB prediction.}"},
    Join[{"\\text{Left: sums of absolute linear responses; }" <> allowTeX <> ",\\ \\delta C_7=41,\\ \\delta C_6=4.9\\times10^{-7}" <>
       If[newStyle, "\\text{ (allowance of the final }" <> c8TeX <> ")", ""] <> ".\\quad\\text{Not a confidence interval.}",
     "\\text{Assumed }C_9^{\\rm hyp}\\text{ (scenario input, not a calculated coefficient). Top: }{" <> fmt[c9ref8, 9] <> "}\\times10^8\\text{, predicted by CB from the }K=8\\text{ baseline (its ninth-order re-expansion),}"},
     If[newStyle,
      {"\\text{so the top CB8}\\to\\text{CB9 shift vanishes identically. Bottom: }{" <> fmt[c9ref, 9] <> "}\\times10^8\\text{, the archived }K=4\\text{ PB}[5/3]\\text{ prediction made with the previous }C_8(1)=8.067\\times10^6\\text{, kept as a fixed scenario value;}",
