# Public targets for Resummation/code/comparison: the comparison of HT, NRG and MC with each other and with the resummed
# curves (paper Sec. "Comparison"; the \CMP* macros). New code only (public/); it reads the shipped records of
# ../resum_d1 and ../resum_d23 and the frozen copies of the HT, NRG and MC records in ../../data/inputs.
# Run from this folder:  make -f public.mk test | replay | clean
#
#   test     public/compare.py on the shipped records (the same as replay; it takes seconds).
#   replay   public/compare.py: the HT, NRG and MC values inside the d = 1 comparison table equal the records; the 12
#            \CMP* macros (rules in the table); an INFO row for the d = 2 HT sentence that has no macro; the HT column of tab:num2 and
#            tab:num3 and the MC column of tab:num2 (36 cells) against the records; the three tables
#            of ../../results/comparison/ regenerated byte for byte. Seconds; Python >= 3.10, standard library only.

PY      ?= python3
WORK    ?= .work
export PYTHONDONTWRITEBYTECODE = 1

.PHONY: help test replay clean
help:
	@sed -n '1,10p' public.mk

test replay:
	$(PY) public/compare.py --work $(WORK)

clean:
	rm -rf $(WORK)
