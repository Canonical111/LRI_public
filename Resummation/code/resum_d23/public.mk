# Public targets for Resummation/code/resum_d23: the d = 2 (curvature) and d = 3 (slope) conformal Borel resummations
# with the short-range end imposed, the GFF-only CB3/CB8 controls and the 2d/3d literature table. Scripts and records
# ship verbatim from the production folders (layout kept: 2d/, 3d/, combined/); public/ is added.
# Run from this folder:  make -f public.mk test | replay | replay-full | figures | clean
#
#   test         public/selftest_d23.py: inputs present; the verbatim 3d/code/calculate.py rerun in a copy reproduces the
#                shipped 3d baseline columns to 1e-12. About 15 s on one core.
#   replay       public/replay_d23.py: every quoted d = 2, 3 number of this package and the 28 resummed values of
#                tab:num2 and tab:num3 from the shipped records, the plotted data against the curve tables, and the literature
#                table regenerated byte for byte from the frozen extraction in ../../data/inputs/literature. Seconds.
#   replay-full  public/replay_full_d23.py: reruns all ten scripts and the CB3 script in a copy under $(WORK)/full,
#                compares every output with the shipped one and recomputes the quoted numbers. About 1 min, < 1 GB.
#   figures      rebuilds 06_curves_2d3d{,_clean}.pdf with Wolfram Language (wolframscript; MaTeX needs TeX) in a copy
#                under $(WORK)/figures; desktop only, not through Slurm. Shipped PDFs: ../../results/figures/.

PY      ?= python3
WORK    ?= .work
export PYTHONDONTWRITEBYTECODE = 1
export OPENBLAS_NUM_THREADS = 1
export OMP_NUM_THREADS = 1
export MKL_NUM_THREADS = 1

.PHONY: help test replay replay-full figures clean
help:
	@sed -n '1,18p' public.mk

test:
	$(PY) public/selftest_d23.py

replay:
	$(PY) public/replay_d23.py --work $(WORK)

replay-full:
	$(PY) public/replay_full_d23.py --work $(WORK)

figures:
	rm -rf $(WORK)/figures && mkdir -p $(WORK)/figures
	rsync -a --exclude public/ --exclude .work/ ./ $(WORK)/figures/
	cd $(WORK)/figures && wolframscript -file "$$PWD/run_plot.wls" "$$PWD/plot_lri_2d3d.wl"
	@echo "figures in $(WORK)/figures/figures/ (06_curves_2d3d{,_clean}.pdf)"

clean:
	rm -rf $(WORK)
